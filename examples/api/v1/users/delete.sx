// Delete User
load('examples/api/database.sx')
import http

let db = createDatabase('users')
let id = http.get['id']

if id == null then
    print({ error: 'ID parameter required' })
else
    let users = db.read()
    if users[id] != null then
        // Use the new delete builtin for real removal
        delete(users, id)
        db.save(users)
        print({ success: true, message: 'User deleted' })
    else
        http.status(404)
        print({ error: 'User not found' })
    end
end
